rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Custom functions
    function isAuth(userId) {
      return (request.auth.uid != null && request.auth.uid == userId) || request.auth.token.admin == true;
    }

    match /appModules/{docs} {
      allow read;
      allow write: if isAuth(request.auth.uid);
    }

    match /users/{userid=**} {
      allow read: if isAuth(request.auth.uid);
      allow write: if isAuth(request.auth.uid);
    }
  }
}
